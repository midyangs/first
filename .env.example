# ============================================================
# 榜单星球 部署配置
# 使用方法：
#   1. 复制本文件为 .env    →  cp .env.example .env
#   2. 按需修改下面的配置项
#   3. 执行 ./deploy.sh
# ============================================================

# ---------- 服务端口（宿主机对外端口）----------
# 浏览器访问用的端口。改动后需重新部署，并到云控制台安全组放行新端口。
# 示例：改成 80（需 root/备案）或 8080
PORT=8000

# ---------- 初始管理员账号 ----------
# ⚠ 仅首次启动（数据库为空）时生效；之后请在管理后台「账号设置」中修改
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ---------- 登录令牌有效期（秒）----------
# 默认 86400 = 24 小时
TOKEN_TTL=86400

# ---------- 数据库文件路径（容器内路径，通常无需修改）----------
DB_PATH=/app/data/rankplanet.db

# ---------- 是否导入内置示例榜单 ----------
# 1 = 首次启动导入 6 份成都示例榜单；0 = 空库启动
SEED_DATA=1
