# 版本控制
.git
.gitignore
CHANGELOG.md

# 文档（镜像内不需要）
docs/
*.md

# 数据（运行时应挂载卷，不打进镜像）
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 本地配置与脚本
.env
.env.local
deploy.sh
docker-compose.yml

# 依赖与缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
node_modules/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
